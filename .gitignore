# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# large source-asset intermediates (~150MB) — the pipeline that produces
# public/models/character.glb from these is documented in
# components/avatar/AvatarModel.tsx's header comment; regenerate rather than
# commit. robot-archive/ is small (180KB) and stays tracked for reference.
/assets-src/mixamo/
/assets-src/mixamo-converted/
